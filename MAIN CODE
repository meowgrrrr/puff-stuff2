 render();
}
function randomOrder(){
 const fl=MENU.filter(i=>!i.add),n=1+Math.floor(Math.random()*3),items=[];
 for(let k=0;k<n;k++){const m=fl[Math.floor(Math.random()*fl.length)];const adds=Math.random()<.6?[ADDS[Math.floor(Math.random()*ADDS.length)].id]:[];items.push({m,q:1+Math.floor(Math.random()*2),adds});}
 createProc(items);render();
}
function setPlay(on){playing=on;$('play').textContent=on?'Pause':'Play';clearInterval(timer);if(on)timer=setInterval(tick,+$('spd').value);}
document.addEventListener('click',e=>{
 const t=e.target.closest('button');if(!t)return;const D=t.dataset;
 if(D.t){tab=D.t;renderMenu();}
 if(D.o){const i=get(D.o);if(i.add)openPick(i);else{cur={id:i.id,q:1,adds:[],line:null};openCustom();}}
 if(D.t2){const a=cur.adds,k=a.indexOf(D.t2);k<0?a.push(D.t2):a.splice(k,1);openCustom();}
 if(D.cq){cur.q=Math.max(1,cur.q+ +D.cq);openCustom();}
 if(D.save){if(cur.line==null)addLine({id:cur.id,q:cur.q,adds:cur.adds.slice()});else cart[cur.line].adds=cur.adds.slice();$('cm').classList.remove('show');renderCart();}
 if(D.close){$('cm').classList.remove('show');renderCart();}
 if(D.att){const [k,a]=D.att.split('|'),l=cart[+k],j=l.adds.indexOf(a);j<0?l.adds.push(a):l.adds.splice(j,1);openPick(get(a));renderCart();}
 if(D.e){cur={id:cart[+D.e].id,q:1,adds:cart[+D.e].adds.slice(),line:+D.e};openCustom();}
 if(D.u){cart[+D.u].q++;renderCart();}
 if(D.d){if(--cart[+D.d].q<=0)cart.splice(+D.d,1);renderCart();}
});
$('checkout').onclick=checkout;$('rand').onclick=randomOrder;
$('play').onclick=()=>setPlay(!playing);$('step').onclick=()=>{setPlay(false);tick();};
$('spd').onchange=()=>playing&&setPlay(true);
$('reset').onclick=()=>{procs=[];clock=0;running=null;qUsed=0;gantt=[];ctx=0;logs=[];pid=101;seq=0;last=null;cart=[];render();};
$('vStory').onclick=()=>{document.body.classList.remove('os');$('vStory').className='on';$('vOS').className='';};
$('vOS').onclick=()=>{document.body.classList.add('os');$('vOS').className='on';$('vStory').className='';};
renderMenu();render();setPlay(true);
</script></body></html>
